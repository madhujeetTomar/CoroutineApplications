// onCreate() initializes UI components\par}
{\pard \ql \f0 \sa180 \li360 \fi-360 2.\tx360\tab {\b Trigger Coroutine Demo}\par}
{\pard \ql \f0 \sa180 \li360 \fi0 \f1 // User clicks "ClickMe" button\line
clickMe.setOnClickListener \{\line
    tvResult.text = getString(R.string.loading)\line
    CoroutineScope(Dispatchers.IO).launch \{\line
        fakeApiRequest()\line
    \}\line
\}\par}
{\pard \ql \f0 \sa180 \li360 \fi-360 3.\tx360\tab {\b Execute Coroutines with Timeout}\par}
{\pard \ql \f0 \sa180 \li360 \fi0 \f1 private suspend fun fakeApiRequest() \{\line
    withContext(Dispatchers.IO) \{\line
        val job = withTimeoutOrNull(1900) \{\line
            val result1 = result()      // 5 seconds\line
            setResult(result1)\line
            val result2 = result2()     // 5 seconds\line
            setResult(result2)\line
        \}\line
        if (job == null) \{\line
            setResult("Cancelled Job due to TimeOut")\line
        \}\line
    \}\line
\}\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 Concurrent Execution Example\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 // Alternative implementation for parallel execution\line
private suspend fun executeParallel() \{\line
    withContext(Dispatchers.IO) \{\line
        val deferred1 = async \{ result() \}\line
        val deferred2 = async \{ result2() \}\line
        val results = awaitAll(deferred1, deferred2)\line
        setResult(results)\line
    \}\line
\}\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 Context Switching Pattern\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 // Background work\line
withContext(Dispatchers.IO) \{\line
    val data = performNetworkCall()\line
    \line
    // Switch to Main thread for UI updates\line
    withContext(Dispatchers.Main) \{\line
        updateUI(data)\line
    \}\line
\}\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 Error Handling with Timeout\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 val result = withTimeoutOrNull(timeoutMillis) \{\line
    longRunningOperation()\line
\}\line
\line
if (result == null) \{\line
    handleTimeout()\line
\} else \{\line
    handleSuccess(result)\line
\}\par}
